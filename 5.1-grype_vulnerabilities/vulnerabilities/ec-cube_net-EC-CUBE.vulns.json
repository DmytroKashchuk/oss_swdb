re are no known workarounds for this issue.","cvss":[{"source":"security-advisories@github.com","type":"Secondary","version":"3.1","vector":"CVSS:3.1/AV:N/AC:H/PR:H/UI:N/S:U/C:L/I:N/A:N","metrics":{"baseScore":2.2,"exploitabilityScore":0.8,"impactScore":1.5},"vendorMetadata":{}}],"epss":[{"cve":"CVE-2024-51755","epss":0.00147,"percentile":0.35009,"date":"2026-03-29"}],"cwes":[{"cve":"CVE-2024-51755","cwe":"CWE-668","source":"security-advisories@github.com","type":"Secondary"}]}],"matchDetails":[{"type":"exact-direct-match","matcher":"stock-matcher","searchedBy":{"language":"php","namespace":"github:language:php","package":{"name":"twig/twig","version":"v3.8.0"}},"found":{"vulnerabilityID":"GHSA-jjxq-ff2g-95vh","versionConstraint":"<3.11.2 (semantic)"},"fix":{"suggestedVersion":"3.11.2"}}],"artifact":{"id":"pkg:composer/twig/twig@v3.8.0?package-id=b9cd7257d502cdf1","name":"twig/twig","version":"v3.8.0","type":"php-composer","locations":[{"path":"/composer.lock","accessPath":""}],"language":"php","licenses":["BSD-3-Clause"],"cpes":["cpe:2.3:a:twig\\/twig:twig\\/twig:v3.8.0:*:*:*:*:*:*:*"],"purl":"pkg:composer/twig/twig@v3.8.0","upstreams":[]}},{"vulnerability":{"id":"GHSA-3rg7-wf37-54rm","dataSource":"https://github.com/advisories/GHSA-3rg7-wf37-54rm","namespace":"github:language:php","severity":"High","urls":["https://github.com/symfony/symfony/security/advisories/GHSA-3rg7-wf37-54rm","https://github.com/symfony/symfony/commit/9962b91b12bb791322fa73836b350836b6db7cac","https://github.com/FriendsOfPHP/security-advisories/blob/master/symfony/http-foundation/CVE-2025-64500.yaml","https://github.com/FriendsOfPHP/security-advisories/blob/master/symfony/symfony/CVE-2025-64500.yaml","https://symfony.com/blog/cve-2025-64500-incorrect-parsing-of-path-info-can-lead-to-limited-authorization-bypass","https://nvd.nist.gov/vuln/detail/CVE-2025-64500"],"description":"Symfony's incorrect parsing of PATH_INFO can lead to limited authorization bypass","cvss":[{"type":"Secondary","vers