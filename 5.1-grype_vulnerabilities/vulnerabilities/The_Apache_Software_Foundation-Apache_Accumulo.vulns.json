{"matches":[{"vulnerability":{"id":"GHSA-xw7x-h9fj-p2c7","dataSource":"https://github.com/advisories/GHSA-xw7x-h9fj-p2c7","namespace":"github:language:java","severity":"Critical","urls":["https://github.com/open-telemetry/opentelemetry-java-instrumentation/security/advisories/GHSA-xw7x-h9fj-p2c7","https://github.com/open-telemetry/opentelemetry-java-instrumentation/commit/9cf4fbaaa9e79226142b2ed42a6f6b4ac0be2197","https://github.com/open-telemetry/opentelemetry-java-instrumentation/releases/tag/v2.26.1","https://nvd.nist.gov/vuln/detail/CVE-2026-33701"],"description":"OpenTelemetry: Unsafe Deserialization in RMI Instrumentation may Lead to Remote Code Execution","cvss":[{"type":"Secondary","version":"4.0","vector":"CVSS:4.0/AV:N/AC:L/AT:N/PR:N/UI:N/VC:H/VI:H/VA:H/SC:N/SI:N/SA:N","metrics":{"baseScore":9.3},"vendorMetadata":{}}],"epss":[{"cve":"CVE-2026-33701","epss":0.00502,"percentile":0.65953,"date":"2026-03-29"}],"cwes":[{"cve":"CVE-2026-33701","cwe":"CWE-502","source":"security-advisories@github.com","type":"Primary"}],"fix":{"versions":["2.26.1"],"state":"fixed","available":[{"version":"2.26.1","date":"2026-03-26","kind":"first-observed"}]},"advisories":[],"risk":0.45933000000000007},"relatedVulnerabilities":[{"id":"CVE-2026-33701","dataSource":"https://nvd.nist.gov/vuln/detail/CVE-2026-33701","namespace":"nvd:cpe","severity":"Critical","urls":["https://github.com/open-telemetry/opentelemetry-java-instrumentation/commit/9cf4fbaaa9e79226142b2ed42a6f6b4ac0be2197","https://github.com/open-telemetry/opentelemetry-java-instrumentation/releases/tag/v2.26.1","https://github.com/open-telemetry/opentelemetry-java-instrumentation/security/advisories/GHSA-xw7x-h9fj-p2c7"],"description":"OpenTelemetry Java Instrumentation provides OpenTelemetry auto-instrumentation and instrumentation libraries for Java. In versions prior to 2.26.1, the RMI instrumentation registered a custom endpoint that deserialized incoming data without applying serialization filters. On JDK version 16 and earlier, an attacker with network access to a JMX or RMI port on an instrumented JVM could exploit this to potentially achieve remote code execution. All three of the following conditions must be true to exploit this vulnerability: First, OpenTelemetry Java instrumentation is attached as a Java agent (`-javaagent`) on Java 16 or earlier. Second, JMX/RMI port has been explicitly configured via `-Dcom.sun.management.jmxremote.port` and is network-reachable. Third, gadget-chain-compatible library is present on the classpath. This results in arbitrary remote code execution with the privileges of the user running the instrumented JVM. For JDK >= 17, no action is required, but upgrading is strongly encouraged. For JDK < 17, upgrade to version 2.26.1 or later. As a workaround, set the system property `-Dotel.instrumentation.rmi.enabled=false` to disable the RMI integration.","cvss":[{"source":"security-advisories@github.com","type":"Secondary","version":"4.0","vector":"CVSS:4.0/AV:N/AC:L/AT:N/PR:N/UI:N/VC:H/VI:H/VA:H/SC:N/SI:N/SA:N/E:X/CR:X/IR:X/AR:X/MAV:X/MAC:X/MAT:X/MPR:X/MUI:X/MVC:X/MVI:X/MVA:X/MSC:X/MSI:X/MSA:X/S:X/AU:X/R:X/V:X/RE:X/U:X","metrics":{"baseScore":9.3},"vendorMetadata":{}}],"epss":[{"cve":"CVE-2026-33701","epss":0.00502,"percentile":0.65953,"date":"2026-03-29"}],"cwes":[{"cve":"CVE-2026-33701","cwe":"CWE-502","source":"security-advisories@github.com","type":"Primary"}]}],"matchDetails":[{"type":"exact-direct-match","matcher":"java-matcher","searchedBy":{"language":"java","namespace":"github:language:java","package":{"name":"io.opentelemetry.javaagent:opentelemetry-javaagent","version":"2.14.0"}},"found":{"vulnerabilityID":"GHSA-xw7x-h9fj-p2c7","versionConstraint":"<2.26.1 (unknown)"},"fix":{"suggestedVersion":"2.26.1"}}],"artifact":{"id":"pkg:maven/io.opentelemetry.javaagent/opentelemetry-javaagent@2.14.0?package-id=e35c14a649f89ffd","name":"opentelemetry-javaagent","version":"2.14.0","type":"java-archive","locations":[{"path":"/test/pom.xml","accessP