debian.org/debian-lts-announce/2025/05/msg00039.html"],"description":"Twig is a template language for PHP. In a sandbox, an attacker can call `__toString()` on an object even if the `__toString()` method is not allowed by the security policy when the object is part of an array or an argument list (arguments to a function or a filter for instance). This issue has been patched in versions 3.11.2 and 3.14.1. All users are advised to upgrade. There are no known workarounds for this issue.","cvss":[{"source":"security-advisories@github.com","type":"Secondary","version":"3.1","vector":"CVSS:3.1/AV:N/AC:H/PR:H/UI:N/S:U/C:L/I:N/A:N","metrics":{"baseScore":2.2,"exploitabilityScore":0.8,"impactScore":1.5},"vendorMetadata":{}}],"epss":[{"cve":"CVE-2024-51754","epss":0.00135,"percentile":0.33195,"date":"2026-03-29"}],"cwes":[{"cve":"CVE-2024-51754","cwe":"CWE-668","source":"security-advisories@github.com","type":"Secondary"}]}],"matchDetails":[{"type":"exact-direct-match","matcher":"stock-matcher","searchedBy":{"language":"php","namespace":"github:language:php","package":{"name":"twig/twig","version":"v1.44.8"}},"found":{"vulnerabilityID":"GHSA-6377-hfv9-hqf6","versionConstraint":"<3.11.2 (semantic)"},"fix":{"suggestedVersion":"3.11.2"}}],"artifact":{"id":"pkg:composer/twig/twig@v1.44.8?package-id=c8d8ec41380436d2","name":"twig/twig","version":"v1.44.8","type":"php-composer","locations":[{"path":"/composer.lock","accessPath":""}],"language":"php","licenses":["BSD-3-Clause"],"cpes":["cpe:2.3:a:twig\\/twig:twig\\/twig:v1.44.8:*:*:*:*:*:*:*"],"purl":"pkg:composer/twig/twig@v1.44.8","upstreams":[]}},{"vulnerability":{"id":"CVE-2025-67746","dataSource":"https://nvd.nist.gov/vuln/detail/CVE-2025-67746","namespace":"nvd:cpe","severity":"Medium","urls":["https://github.com/composer/composer/commit/1d40a95c9d39a6b7f80d404ab30336c586da9917","https://github.com/composer/composer/commit/5db1876a76fdef76d3c4f8a27995c434c7a43e71","https://github.com/composer/composer/releases/tag/2.2.26","https://github.com/composer/composer/releases/tag/2.9.3","https://github.com/composer/composer/security/advisories/GHSA-59pp-r3rg-353g"],"description":"Composer is a dependency manager for PHP. In versions on the 2.x branch prior to 2.2.26 and 2.9.3, attackers controlling remote sources that Composer downloads from might in some way inject ANSI control characters in the terminal output of various Composer commands, causing mangled output and potentially leading to confusion or DoS of the terminal application. There is no proven exploit and this has thus a low severity but we still publish a CVE as it has potential for abuse, and we want to be on the safe side informing users that they should upgrade. Versions 2.2.26 and 2.9.3 contain a patch for the issue.","cvss":[{"source":"nvd@nist.gov","type":"Primary","version":"3.1","vector":"CVSS:3.1/AV:N/AC:L/PR:L/UI:N/S:U/C:N/I:N/A:L","metrics":{"baseScore":4.3,"exploitabilityScore":2.9,"impactScore":1.5},"vendorMetadata":{}},{"source":"security-advisories@github.com","type":"Secondary","version":"4.0","vector":"CVSS:4.0/AV:N/AC:L/AT:N/PR:L/UI:N/VC:N/VI:N/VA:L/SC:N/SI:N/SA:N/E:U/CR:X/IR:X/AR:X/MAV:X/MAC:X/MAT:X/MPR:X/MUI:X/MVC:X/MVI:X/MVA:X/MSC:X/MSI:X/MSA:X/S:X/AU:X/R:X/V:X/RE:X/U:X","metrics":{"baseScore":1.3},"vendorMetadata":{}}],"epss":[{"cve":"CVE-2025-67746","epss":0.0003,"percentile":0.08686,"date":"2026-03-29"}],"cwes":[{"cve":"CVE-2025-67746","cwe":"CWE-74","source":"security-advisories@github.com","type":"Primary"}],"fix":{"versions":["2.2.26","2.9.3"],"state":"fixed","available":[{"version":"2.2.26","date":"2026-01-08","kind":"first-observed"},{"version":"2.9.3","date":"2026-01-08","kind":"first-observed"}]},"advisories":[],"risk":0.0117},"relatedVulnerabilities":[],"matchDetails":[{"type":"cpe-match","matcher":"stock-matcher","searchedBy":{"namespace":"nvd:cpe","cpes":["cpe:2.3:a:getcomposer:composer:2.7.2:*:*:*:*:*:*:*"],"package":{"name":"composer","version":"2.7.2"}},"found":{"vulnerabilityID":"CVE-2025-67746","versionConstraint":">= 2.0, < 2.2.26,>= 2.3, < 2.9.3 (unknown)","cpes":["cpe:2.3:a:getcomposer:composer:*:*:*:*:*:php:*:*"]},"fix":{"suggestedVersion":"2.9.3"}}],"artifact":{"id":"pkg:generic/composer@2.7.2?package-id=5a93167b34e2e140","name":"composer","version":"2.7.2","type":"php-composer","locations":[{"path":"/bin/composer.phar","accessPath":""}],"language":"","licenses":[],"cpes":["cpe:2.3:a:getcomposer:composer:2.7.2:*:*:*:*:*:*:*"],"purl":"pkg:generic/composer@2.7.2","upstreams":[]}},{"vulnerability":{"id":"GHSA-r39x-jcww-82v6","dataSource":"https://github.com/advisories/GHSA-r39x-jcww-82v6","namespace":"github:language:php","severity":"Medium","urls":["https://github.com/symfony/symfony/security/advisories/GHSA-r39x-jcww-82v6","https://github.com/symfony/symfony/issues/62921","https://github.com/symfony/symfony/pull/63164","https://github.com/symfony/symfony/commit/35203939050e5abd3caf2202113b00cab5d379b3","https://github.com/symfony/symfony/commit/ec154f6f95f8c60f831998ec4d246a857e9d179b","https://nvd.nist.gov/vuln/detail/CVE-2026-24739"],"description":"Symfony's incorrect argument escaping under MSYS2/Git Bash can lead to destructive file operations on Windows","cvss":[{"type":"Secondary","version":"3.1","vector":"CVSS:3.1/AV:L/AC:H/PR:N/UI:R/S:U/C:N/I:H/A:H","metrics":{"baseScore":6.3,"exploitabilityScore":1.1,"impactScore":5.2},"vendorMetadata":{}}],"epss":[{"cve":"CVE-2026-24739","epss":0.00008,"percentile":0.00724,"date":"2026-03-29"}],"cwes":[{"cve":"CVE-2026-24739","cwe":"CWE-88","source":"security-advisories@github.com","type":"Primary"}],"fix":{"versions":["5.4.51"],"state":"fixed","available":[{"version":"5.4.51","date":"2026-01-29","kind":"first-observed"}]},"advisories":[],"risk":0.00452},"relatedVulnerabilities":[{"id":"CVE-2026-24739","dataSource":"https://nvd.nist.gov/vuln/detail/CVE-2026-24739","namespace":"nvd:cpe","severity":"Medium","urls":["https://github.com/symfony/symfony/commit/35203939050e5abd3caf2202113b00cab5d379b3","https://github.com/symfony/symfony/commit/ec154f6f95f8c60f831998ec4d246a857e9d179b","https://github.com/symfony/symfony/issues/62921","https://github.com/symfony/symfony/pull/63164","https://github.com/symfony/symfony/security/advisories/GHSA-r39x-jcww-82v6"],"description":"Symfony is a PHP framework for web and console applications and a set of reusable PHP components. Prior to versions 5.4.51, 6.4.33, 7.3.11, 7.4.5, and 8.0.5, the Symfony Process component did not correctly treat some characters (notably `=`) as “special” when escaping arguments on Windows. When PHP is executed from an MSYS2-based environment (e.g. Git Bash) and Symfony Process spawns native Windows executables, MSYS2’s argument/path conversion can mis-handle unquoted arguments containing these characters. This can cause the spawned process to receive corrupted/truncated arguments compared to what Symfony intended. If an application (or tooling such as Composer scripts) uses Symfony Process to invoke file-management commands (e.g. `rmdir`, `del`, etc.) with a path argument containing `=`, the MSYS2 conversion layer may alter the argument at runtime. In affected setups this can result in operations being performed on an unintended path, up to and including deletion of the contents of a broader directory or drive. The issue is particularly relevant when untrusted input can influence process arguments (directly or indirectly, e.g. via repository paths, extracted archive paths, temporary directories, or user-controlled configuration). Versions 5.4.51, 6.4.33, 7.3.11, 7.4.5, and 8.0.5 contains a patch for the issue. Some workarounds are available. Avoid running PHP/one's own tooling from MSYS2-based shells on Windows; prefer cmd.exe or PowerShell for workflows that spawn native executables. Avoid passing paths containing `=` (and similar MSYS2-sensitive characters) to Symfony Process when operating under Git Bash/MSYS2. Where applicable, configure MSYS2 to disable or restrict argument conversion (e.g. via `MSYS2_ARG_CONV_EXCL`), understanding this may affect other tooling behavior.","cvss":[{"source":"security-advisories@github.com","type":"Secondary","version":"3.1","vector":"CVSS:3.1/AV:L/AC:H/PR:N/UI:R/S:U/C:N/I:H/A:H","metrics":{"baseScore":6.3,"exploitabilityScore":1.1,"impactScore":5.2},"vendorMetadata":{}}],"epss":[{"cve":"CVE-2026-24739","epss":0.00008,"percentile":0.00724,"date":"2026-03-29"}],"cwes":[{"cve":"CVE-2026-24739","cwe":"CWE-88","source":"security-advisories@github.com","type":"Primary"}]}],"matchDetails":[{"type":"exact-direct-match","matcher":"stock-matcher","searchedBy":{"language":"php","namespace":"github:language:php","package":{"name":"symfony/process","version":"v4.4.44"}},"found":{"vulnerabilityID":"GHSA-r39x-jcww-82v6","versionConstraint":"<5.4.51 (semantic)"},"fix":{"suggestedVersion":"5.4.51"}}],"artifact":{"id":"pkg:composer/symfony/process@v4.4.44?package-id=18e2883cac6baa82","name":"symfony/process","version":"v4.4.44","type":"php-composer","locations":[{"path":"/composer.lock","accessPath":""}],"language":"php","licenses":["MIT"],"cpes":["cpe:2.3:a:symfony\\/process:symfony\\/process:v4.4.44:*:*:*:*:*:*:*"],"purl":"pkg:composer/symfony/process@v4.4.44","upstreams":[]}}],"source":{"type":"file","target":"/Users/dmk6603/Documents/cloned_repos_oss_swdb/Grav-Grav"},"distro":{"name":"","version":"","idLike":null},"descriptor":{"name":"grype","version":"0.110.0","configuration":{"output":["json=vulnerabilities/Grav-Grav.vulns.json"],"file":"","pretty":false,"distro":"","add-cpes-if-none":false,"output-template-file":"","check-for-app-update":true,"only-fixed":false,"only-notfixed":false,"ignore-wontfix":"","platform":"","search":{"scope":"squashed","unindexed-archives":false,"indexed-archives":true},"ignore":[{"vulnerability":"","include-aliases":false,"reason":"","namespace":"","fix-state":"","package":{"name":"kernel-headers","version":"","language":"","type":"rpm","location":"","upstream-name":"kernel"},"vex-status":"","vex-justification":"