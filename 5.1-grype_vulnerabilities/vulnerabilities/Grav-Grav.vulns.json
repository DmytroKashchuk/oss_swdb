-client","version":"v4.4.51"}},"found":{"vulnerabilityID":"GHSA-9c3x-r3wp-mgxm","versionConstraint":">=4.3.0,<5.4.47 (semantic)"},"fix":{"suggestedVersion":"5.4.47"}}],"artifact":{"id":"pkg:composer/symfony/http-client@v4.4.51?package-id=7e413da112e7d33f","name":"symfony/http-client","version":"v4.4.51","type":"php-composer","locations":[{"path":"/composer.lock","accessPath":""}],"language":"php","licenses":["MIT"],"cpes":["cpe:2.3:a:symfony\\/http-client:symfony\\/http-client:v4.4.51:*:*:*:*:*:*:*","cpe:2.3:a:symfony\\/http-client:symfony\\/http_client:v4.4.51:*:*:*:*:*:*:*","cpe:2.3:a:symfony\\/http_client:symfony\\/http-client:v4.4.51:*:*:*:*:*:*:*","cpe:2.3:a:symfony\\/http_client:symfony\\/http_client:v4.4.51:*:*:*:*:*:*:*","cpe:2.3:a:symfony\\/http:symfony\\/http-client:v4.4.51:*:*:*:*:*:*:*","cpe:2.3:a:symfony\\/http:symfony\\/http_client:v4.4.51:*:*:*:*:*:*:*"],"purl":"pkg:composer/symfony/http-client@v4.4.51","upstreams":[]}},{"vulnerability":{"id":"GHSA-jjxq-ff2g-95vh","dataSource":"https://github.com/advisories/GHSA-jjxq-ff2g-95vh","namespace":"github:language:php","severity":"Low","urls":["https://github.com/twigphp/Twig/security/advisories/GHSA-jjxq-ff2g-95vh","https://github.com/twigphp/Twig/commit/831c148e786178e5f2fde9db67266be3bf241c21","https://nvd.nist.gov/vuln/detail/CVE-2024-51755","https://github.com/FriendsOfPHP/security-advisories/blob/master/twig/twig/CVE-2024-51755.yaml","https://symfony.com/blog/unguarded-calls-to-__isset-and-to-array-accesses-when-the-sandbox-is-enabled"],"description":"Twig has unguarded calls to `__isset()` and to array-accesses when the sandbox is enabled","cvss":[{"type":"Secondary","version":"3.1","vector":"CVSS:3.1/AV:N/AC:H/PR:H/UI:N/S:U/C:L/I:N/A:N","metrics":{"baseScore":2.2,"exploitabilityScore":0.8,"impactScore":1.5},"vendorMetadata":{}},{"type":"Secondary","version":"4.0","vector":"CVSS:4.0/AV:N/AC:L/AT:P/PR:H/UI:N/VC:L/VI:N/VA:N/SC:N/SI:N/SA:N","metrics":{"baseScore":2.1},"vendorMetadata":{}}],"epss":[{"cve":