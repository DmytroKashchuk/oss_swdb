ulnerability. Only applications that call `extract_zipped_paths()` directly are impacted. Starting in version 2.33.0, the library extracts files to a non-deterministic location. If developers are unable to upgrade, they can set `TMPDIR` in their environment to a directory with restricted write access.","cvss":[{"source":"security-advisories@github.com","type":"Secondary","version":"3.1","vector":"CVSS:3.1/AV:L/AC:H/PR:L/UI:R/S:U/C:N/I:H/A:N","metrics":{"baseScore":4.4,"exploitabilityScore":0.8,"impactScore":3.6},"vendorMetadata":{}}],"epss":[{"cve":"CVE-2026-25645","epss":0.00004,"percentile":0.00193,"date":"2026-03-29"}],"cwes":[{"cve":"CVE-2026-25645","cwe":"CWE-377","source":"security-advisories@github.com","type":"Secondary"}]}],"matchDetails":[{"type":"exact-direct-match","matcher":"python-matcher","searchedBy":{"language":"python","namespace":"github:language:python","package":{"name":"requests","version":"2.32.4"}},"found":{"vulnerabilityID":"GHSA-gc5v-m9x4-r6x2","versionConstraint":"<2.33.0 (python)"},"fix":{"suggestedVersion":"2.33.0"}}],"artifact":{"id":"pkg:pypi/requests@2.32.4?package-id=6c1a272a50bcff21","name":"requests","version":"2.32.4","type":"python","locations":[{"path":"/src/mango/requirements.txt","accessPath":""}],"language":"python","licenses":[],"cpes":["cpe:2.3:a:python:requests:2.32.4:*:*:*:*:*:*:*"],"purl":"pkg:pypi/requests@2.32.4","upstreams":[]}}],"source":{"type":"file","target":"/Users/dmk6603/Documents/cloned_repos_oss_swdb/The_Apache_Software_Foundation-Apache_CouchDB"},"distro":{"name":"","version":"","idLike":null},"descriptor":{"name":"grype","version":"0.110.0","configuration":{"output":["json=vulnerabilities/The_Apache_Software_Foundation-Apache_CouchDB.vulns.json"],"file":"","pretty":false,"distro":"","add-cpes-if-none":false,"output-template-file":"","check-for-app-update":true,"only-fixed":false,"only-notfixed":false,"ignore-wontfix":"","platform":"","search":{"scope":"squashed","unindexed-archives":false,"indexed-archives"